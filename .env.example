# 학교 마인드로직 팩트챗(FactChat) API 키 설정
# .env 파일로 복사한 뒤 실제 발급받은 키를 입력하세요.
#
# ※ 주의: 현재 코드에는 .env 파일을 자동으로 읽는 로더(python-dotenv 등)가 없습니다.
#   스크립트 실행 전에 셸에서 환경 변수를 직접 설정하세요. (PowerShell 예: $env:FACTCHAT_API_KEY="키")
FACTCHAT_API_KEY=your_factchat_api_key_here
FACTCHAT_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
# 지정하지 않으면 config.py는 claude-sonnet-5, src/schoolApi.py는 gpt-5.1을 기본값으로 사용합니다.
FACTCHAT_MODEL=claude-sonnet-5

# NVIDIA API 게이트웨이 (src/nvidiaApi.py 실험 스크립트 전용, 선택)
NVIDIA_API_KEY=your_nvidia_api_key_here
