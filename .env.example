# AI 파트 환경 변수 템플릿
# 이 파일을 같은 폴더에 .env로 복사한 뒤 실제 키를 입력하세요. (.env는 git에 올라가지 않습니다)
# src/config.py가 import될 때 자동으로 읽습니다. 셸에 이미 설정된 환경 변수가 있으면 그 값이 우선합니다.

# 학교 마인드로직 팩트챗(FactChat) 게이트웨이 — 기본 LLM
FACTCHAT_API_KEY=your_factchat_api_key_here
FACTCHAT_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
FACTCHAT_MODEL=gpt-5.1

# /api/chat 오케스트레이터가 쓸 게이트웨이 (factchat | nvidia)
LLM_PROVIDER=factchat

# 응답 속도 옵션 (이슈 #17, docs/BENCHMARK.md). 기본값은 기존 동작
LLM_PRERESOLVE=false
LLM_ANSWER_MODE=llm

# /api/chat을 부를 수 있는 FE 출처 (쉼표로 구분). 기본 * (개발용)
CORS_ALLOW_ORIGINS=*

# 도구가 읽을 데이터 소스 (mock | be). be는 BE 서버를 먼저 띄운다 (BE/docs/demo-handoff.md)
AI_DATA_SOURCE=mock
BE_API_BASE_URL=http://127.0.0.1:8000
BE_API_TIMEOUT_SECONDS=2.0

# NVIDIA API 게이트웨이 — 비교 실험용 (선택)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.3-flash
