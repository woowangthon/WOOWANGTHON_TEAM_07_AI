# =============================================================================
# 우왕톤 7팀 AI 파트 .gitignore
# =============================================================================

# 1. 환경 변수 및 시크릿 (절대 깃허브에 커밋되면 안 됨)
.env
.env.local
.env.*.local
*.key
*.pem
secrets/

# 단, 템플릿 파일은 형상 관리에 포함
!.env.example

# 2. 파이썬 바이트코드 및 캐시
__pycache__/
*.py[cod]
*$py.class
*.so

# 3. 가상환경 (Virtual Environments)
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# 4. 테스트 및 커버리지 아티팩트
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/

# 5. IDE 및 에디터 설정
.vscode/
.idea/
*.swp
*.swo

# 6. 운영체제 생성 파일
.DS_Store
Thumbs.db
desktop.ini

# 7. 로그 및 임시 파일
*.log
logs/
tmp/
temp/

